# ACO System — Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# GitHub Integration
# =============================================================================
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-github-org-or-username
GITHUB_REPO=your-repository-name

# =============================================================================
# LLM Provider (choose one section based on your provider)
# =============================================================================

# --- OpenAI ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your_key_here
# OPENAI_MODEL=gpt-6.1-sol

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- xAI ---
# LLM_PROVIDER=xai
# XAI_API_KEY=your_xai_key_here
# XAI_MODEL=grok-4.7

# --- OpenRouter ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OpenRouter model IDs are vendor-prefixed and use a different spelling than
# the Anthropic API ("anthropic/claude-sonnet-5.5", not "claude-sonnet-5-5").
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# --- MiniMax ---
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=your_minimax_key_here
# MINIMAX_MODEL=MiniMax-M3

# Output token cap per request. Reasoning models spend part of this budget on
# thinking tokens, so a small cap truncates the visible answer to empty.
# MAX_TOKENS=16384

# =============================================================================
# Database
# =============================================================================
# SQLite (default for local development)
DATABASE_URL=sqlite:///./data/aco.db

# PostgreSQL (recommended for production/multi-instance)
# DATABASE_URL=postgresql://user:pass@localhost:5432/aco

# =============================================================================
# Redis (optional — for distributed task queue)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Agent Settings
# =============================================================================
AGENT_POLL_INTERVAL_SECONDS=30
MAX_RETRY_ATTEMPTS=3

# =============================================================================
# Per-Agent Model Override (optional)
# Tip: Opus for complex reasoning, Sonnet for implementation, Haiku for lightweight tasks
# Set to "none" to disable LLM for that agent
#
# The value is used verbatim, so it must be a model ID the configured provider
# accepts. Both spellings work: ACO_PM_MODEL and ACO-PM-MODEL.
# =============================================================================
# ACO-PM_MODEL=claude-haiku-5-5
# ACO-ARCHITECT_MODEL=claude-opus-5-5
# ACO-DEV_MODEL=claude-sonnet-5-5
# ACO-PLANNER_MODEL=claude-opus-5-5
# ACO-QA_MODEL=claude-sonnet-5-5
# ACO-HUMAN=none

# =============================================================================
# Human Contact (for agent escalations — set to "none" to disable)
# =============================================================================
HUMAN_CONTACT_METHOD=whatsapp
HUMAN_PHONE=+1234567890
